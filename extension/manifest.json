{
  "manifest_version": 3,
  "name": "Undertone \u2014 Fish Audio companion",
  "version": "0.1.1",
  "description": "Listen to selected text with Fish Audio, or send it to your Undertone voice studio.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.fish.audio/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Undertone"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "124",
  "version_name": "0.1.1-beta.1"
}
