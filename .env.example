# Optional. Set only when using your own canonical production domain.
# Vercel automatically supplies VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional public verification values from your own webmaster account.
# Redeploy after configuring these in Vercel. No API keys belong here.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
