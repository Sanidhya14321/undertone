{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "functions": {
    "app/api/fish/[...path]/route.ts": {
      "maxDuration": 300
    }
  },
  "alias": [
    "undertone.vercel.app",
    "undertone-voice-workspace.vercel.app"
  ]
}
